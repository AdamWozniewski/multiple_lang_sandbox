<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/main.css">
    <title><%= t('title'); %></title>
</head>
<body class="min-h-screen bg-slate-950 font-sans text-slate-100 antialiased">
<% if(process.env.NODE_ENV === 'development') { %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 bg-slate-900 px-4 py-1.5 text-xs text-slate-300">
        <span class="font-semibold uppercase tracking-wide text-amber-400">Dev</span>
        <span>ENV: <b class="font-mono text-slate-100"><%- process.env.NODE_ENV; %></b></span>
        <span>branch: <b class="font-mono text-slate-100"><%- gitBranch; %></b></span>
        <span>commit: <b class="font-mono text-slate-100"><%- gitCommitHash; %></b></span>
        <a target="_blank" href="/graphql" class="ml-auto font-semibold text-indigo-400 hover:text-indigo-300">GraphQL Playground →</a>
    </div>
<% } %>




