<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <form method="POST" class="flex flex-col">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="card-header">
                <h3 class="card-header-title">Zarejestruj się</h3>
            </div>
            <div class="card-body">
                <div class="field">
                    <label class="field-label">Email</label>
                    <input value="<%= form?.email %>" required type="email" name="email"
                           class="field-input" placeholder="Twój adres e-mail" />
                    <% if(errors?.email) { %>
                        <div class="field-error"><%= errors %></div>
                    <% } %>
                </div>

                <div class="field">
                    <label class="field-label">Hasło</label>
                    <input value="<%= form?.password %>" type="password" name="password" required
                           class="field-input" placeholder="Twoje hasło" />
                    <% if (errors?.email) { %>
                        <div class="field-error"><%= errors?.email %></div>
                    <% } %>
                </div>
                <div class="field">
                    <label class="field-label">Powtórz hasło</label>
                    <input value="<%= form?.password %>" type="password" name="repeat-password" required
                           class="field-input" placeholder="Powtórz hasło" />
                    <% if (errors?.password) { %>
                        <div class="field-error"><%= errors?.password %></div>
                    <% } %>
                </div>
                <% if (errors) { %>
                    <div class="field-error"><%= errors %></div>
                <% } %>
            </div>

            <div class="card-footer flex flex-col gap-3">
                <button class="btn-primary btn-block" type="submit">
                    Zarejestruj
                </button>
                <p class="flex justify-center text-sm text-slate-400">
                    Masz konto?
                    <a href="/<%= language ;%>/login" class="ml-1 link">
                        Zaloguj się
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>
