<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <div class="card-header">
            <h3 class="card-header-title">Coś poszło nie tak</h3>
        </div>
        <div class="card-body">
            <% if(errors) { %>
                <div class="alert-error"><%= errors.message %></div>
            <% } %>
        </div>
        <div class="card-footer text-center">
            <a href="/<%= language ;%>/login" class="link">
                Zaloguj się ponownie
            </a>
        </div>
    </div>
</div>
