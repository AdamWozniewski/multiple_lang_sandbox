<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <form method="POST" class="flex flex-col">
            <div class="card-header">
                <h3 class="card-header-title">Wpisz swój email</h3>
            </div>
            <div class="card-body">
                <div class="field">
                    <label class="field-label">Email</label>
                    <input value="<%= form?.email %>" type="email" name="email" required
                           class="field-input" placeholder="Wpisz swój email" />
                    <% if(errors?.email) { %>
                        <div class="field-error"><%= errors.email %></div>
                    <% } %>
                </div>
                <% if(errors && errors.message) { %>
                    <div class="alert-error"><%= errors.message %></div>
                <% } %>
            </div>
            <div class="card-footer">
                <button class="btn-primary btn-block" type="submit">
                    Wyślij
                </button>
            </div>
        </form>
    </div>
</div>
