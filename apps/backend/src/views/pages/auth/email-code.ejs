<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <form method="POST" class="flex flex-col">
            <%- include('../partials/csrf', { csrfSecret }) %>
            <div class="card-header">
                <h3 class="card-header-title">Kod weryfikacyjny</h3>
            </div>
            <div class="card-body">
                <div class="field">
                    <label class="field-label">Kod weryfikacyjny</label>
                    <input
                            type="text"
                            name="code"
                            class="field-input"
                            placeholder="Wpisz kod z wiadomości e-mail"
                    />
                </div>
                <% if(errors && errors.message) { %>
                    <div class="alert-error"><%= errors.message %></div>
                <% } %>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn-primary btn-block">
                    Zapisz
                </button>
            </div>
        </form>
    </div>
</div>
