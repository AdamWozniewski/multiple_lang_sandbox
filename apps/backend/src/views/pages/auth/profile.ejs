<div class="auth-shell">
    <div class="w-full max-w-md card">
        <form method="POST" class="flex flex-col">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="card-header">
                <h3 class="card-header-title">Edytuj profil</h3>
            </div>

            <div class="card-body">
                <div class="field">
                    <label class="field-label">Email</label>
                    <input
                            value="<%= form?.email %>"
                            type="email"
                            name="email"
                            disabled
                            class="field-input"
                            placeholder="Email"
                    />
                    <% if(errors?.email) { %>
                        <p class="field-error"><%= errors.email.message %></p>
                    <% } %>
                </div>

                <div class="field">
                    <label class="field-label">Hasło</label>
                    <input
                            value="<%= form?.password %>"
                            type="password"
                            name="password"
                            class="field-input"
                            placeholder="Nowe hasło"
                    />
                    <% if(errors?.password) { %>
                        <p class="field-error"><%= errors.password.message %></p>
                    <% } %>
                </div>

                <div class="field">
                    <label class="field-label">Imię</label>
                    <input
                            value="<%= form?.firstName %>"
                            type="text"
                            name="firstName"
                            class="field-input"
                            placeholder="Imię"
                    />
                </div>

                <div class="field">
                    <label class="field-label">Nazwisko</label>
                    <input
                            value="<%= form?.lastName %>"
                            type="text"
                            name="lastName"
                            class="field-input"
                            placeholder="Nazwisko"
                    />
                </div>

                <% if(errors && errors.message) { %>
                    <div class="alert-error"><%= errors.message %></div>
                <% } %>

                <div class="flex items-center justify-between border-t border-slate-800 pt-4">
                    <span class="text-sm font-medium text-slate-300">Dwuskładnikowe uwierzytelnianie</span>
                    <label class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center">
                        <input type="checkbox" id="twoFactorAuthentication" name="twoFactorAuthentication"
                               class="peer absolute h-full w-full cursor-pointer opacity-0" <%= form?.twoFactorAuthentication ? 'checked' : '' %> />
                        <span class="h-6 w-11 rounded-full bg-slate-300 transition duration-300 peer-checked:bg-indigo-600"></span>
                        <span class="absolute left-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform duration-300 peer-checked:translate-x-5"></span>
                    </label>
                </div>

                <div class="field">
                    <label class="field-label" for="twoFactorAuthenticationType">Typ autoryzacji</label>
                    <select id="twoFactorAuthenticationType" name="twoFactorAuthenticationType" class="field-input">
                        <option value="" <%= !form?.twoFactorAuthenticationType ? 'selected' : '' %>>Wybierz 2FA</option>
                        <option value="qr-code" <%= form?.twoFactorAuthenticationType === 'qr-code' ? 'selected' : '' %>>QR Code</option>
                        <option value="verification-code" <%= form?.twoFactorAuthenticationType === 'verification-code' ? 'selected' : '' %>>Email Code</option>
                        <option value="magic-link" <%= form?.twoFactorAuthenticationType === 'magic-link' ? 'selected' : '' %>>Magiczny link</option>
                        <option value="physical-key" <%= form?.twoFactorAuthenticationType === 'physical-key' ? 'selected' : '' %>>Klucz sprzętowy</option>
                        <option value="biometrics" <%= form?.twoFactorAuthenticationType === 'biometrics' ? 'selected' : '' %>>Biometryka</option>
                    </select>
                </div>
            </div>

            <div class="card-footer">
                <button type="submit" class="btn-primary btn-block">
                    Zapisz
                </button>
            </div>
        </form>
    </div>
</div>
