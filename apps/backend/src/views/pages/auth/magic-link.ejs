<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <form method="POST" class="flex flex-col">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="card-header">
                <h3 class="card-header-title">Magic Link</h3>
            </div>
            <div class="card-body">
                <div class="field">
                    <label class="field-label">Email</label>
                    <input value="<%= form?.email ;%>" required type="email" name="email"
                           class="field-input" placeholder="Twój adres e-mail" />
                </div>
                <% if(errors) { %>
                    <div class="alert-error"><%= errors.message %></div>
                <% } %>
            </div>
            <div class="card-footer">
                <button class="btn-primary btn-block" type="submit">
                    Wyślij
                </button>
            </div>
        </form>
    </div>
</div>
