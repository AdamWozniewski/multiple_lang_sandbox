<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <div class="card-header">
            <h3 class="card-header-title">Zaloguj się przez QR</h3>
        </div>
        <div class="card-body items-center text-center">
            <div class="rounded-xl bg-white p-4 shadow-sm">
                <img src="<%= qrDataUrl %>" alt="QR do zatwierdzenia" class="h-56 w-56" />
            </div>
            <p class="text-muted">Zeskanuj kod telefonem, aby zatwierdzić logowanie</p>
            <div id="timer" class="text-sm font-medium text-slate-300"></div>
        </div>
    </div>
</div>
<script>
  const attemptId = "<%= attemptId %>";
  const streamUrl = "<%= streamUrl %>";
  const lng = "<%= language ;%>";

  console.log("[PC] attemptId:", attemptId);
  console.log("[PC] streamUrl:", streamUrl);
  const es = new EventSource(streamUrl);
  es.onmessage = async (ev) => {
    const msg = JSON.parse(ev.data);
    console.log("[PC] SSE:", msg);

    if (msg.status === "approved") {
      es.close();

      const finalizeUrl = `/${lng}/verification/qr-code/finalize`;

      const res = await fetch(finalizeUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ attemptId }),
      });

      const data = await res.json().catch(() => ({}));
      console.log("[PC] finalize:", res.status, data);

      if (res.ok && data.ok) {
        window.location.href = "/";
      } else {
        alert("Finalize failed: " + JSON.stringify(data));
      }
    }

    if (msg.status === "expired" || msg.status === "denied") {
      es.close();
      alert("QR wygasł lub odrzucony");
    }
  };

  es.onerror = (e) => {
    console.error("[PC] SSE error", e);
  };
</script>
