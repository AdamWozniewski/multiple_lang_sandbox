<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <form method="POST" class="flex flex-col">
            <input type="hidden" name="token" value="<%= token; %>">
            <div class="card-header">
                <h3 class="card-header-title">Reset hasła</h3>
            </div>
            <div class="card-body">
                <div class="field">
                    <label class="field-label">Nowe hasło</label>
                    <input value="<%= form?.password %>" type="password" name="password" required
                           class="field-input" placeholder="Nowe hasło" />
                </div>
                <% if(errors) { %>
                    <div class="alert-error"><%= errors.message %></div>
                <% } %>
            </div>
            <div class="card-footer">
                <button class="btn-primary btn-block" type="submit">
                    Zresetuj hasło
                </button>
            </div>
        </form>
    </div>
</div>
