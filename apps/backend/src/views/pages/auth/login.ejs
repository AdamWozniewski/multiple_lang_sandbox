<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <form method="POST" class="flex flex-col">
            <%- include('../partials/csrf', { csrfToken }) %>

            <div class="card-header">
                <h3 class="card-header-title">Zaloguj się</h3>
            </div>
            <div class="card-body">
                <div class="field">
                    <label class="field-label">Email</label>
                    <input value="<%= form?.email ;%>" required type="email" name="email"
                           class="field-input" placeholder="Twój adres e-mail" />
                </div>

                <div class="field">
                    <label class="field-label">Hasło</label>
                    <input value="<%= form?.password ;%>" type="password" name="password" required
                           class="field-input" placeholder="Twoje hasło" />
                </div>
                <% if(errors) { %>
                    <div class="alert-error"><%= errors.message %></div>
                <% } %>
            </div>
            <div class="card-footer flex flex-col gap-3">
                <button class="btn-primary btn-block" type="submit">
                    Zaloguj
                </button>
                <p class="flex justify-center text-sm text-slate-400">
                    Nie masz konta?
                    <a href="/<%= language ;%>/register" class="ml-1 link">
                        Zarejestruj się
                    </a>
                </p>
                <p class="text-center">
                    <a href="/<%= language ;%>/forgot-password" class="link">
                        Zapomniałem hasła
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>
