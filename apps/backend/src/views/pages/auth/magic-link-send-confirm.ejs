<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <div class="card-header">
            <h3 class="card-header-title">Magic Link — wysłano</h3>
        </div>
        <div class="card-body">
            <p class="text-center text-sm text-slate-400">
                Jeżeli email istnieje w naszej bazie, zostanie wysłany na nią link.
            </p>
            <% if(errors) { %>
                <div class="alert-error"><%= errors.message %></div>
            <% } %>
        </div>
    </div>
</div>
