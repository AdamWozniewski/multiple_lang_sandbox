<div class="field mb-4">
    <label class="field-label">Szukaj</label>
    <div class="flex gap-2">
        <input type="text" name="query" value="<%- query.query %>" class="field-input" placeholder="Szukaj firmy…">
        <button class="btn-primary shrink-0">Szukaj</button>
    </div>
    <% if (query.query) { %>
        <p class="field-help">Wyniki wyszukiwania dla frazy „<b><%= query.query %></b>”</p>
    <% } %>
</div>
