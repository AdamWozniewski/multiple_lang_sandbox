<div class="flex flex-col gap-4 border-t border-slate-100 pt-4">
    <h2 class="heading-section">Filtry</h2>

    <div class="field">
        <label for="sort" class="field-label">Sortuj według</label>
        <select name="sort" id="sort" class="field-input">
            <option value="">Domyślnie</option>
            <option value="name|asc" <%- query.sort === 'name|asc' ? 'selected' : '' %>>A-Z</option>
            <option value="name|desc" <%- query.sort === 'name|dsc' ? 'selected' : '' %>>Z-A</option>
            <option value="employeesCount|asc" <%- query.sort === 'employeesCount|asc' ? 'selected' : '' %>>Liczba
                pracowników rosnąco
            </option>
            <option value="employeesCount|desc" <%- query.sort === 'employeesCount|desc' ? 'selected' : '' %>>Liczba
                pracowników malejąco
            </option>
        </select>
    </div>
    <div class="field">
        <label for="countMin" class="field-label">Minimalna liczba pracowników</label>
        <input class="field-input" type="number" value="<%= query.countMin %>" id="countMin" name="countMin">
    </div>
    <div class="field">
        <label for="countMax" class="field-label">Maksymalna liczba pracowników</label>
        <input class="field-input" type="number" value="<%= query.countMax %>" id="countMax" name="countMax">
    </div>
    <button class="btn-primary btn-block">Filtruj</button>
</div>
