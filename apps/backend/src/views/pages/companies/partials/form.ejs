<div class="auth-shell">
    <div class="w-full max-w-sm card">
        <form method="POST" class="flex flex-col" <% if(showFile) { %>enctype="multipart/form-data" action="?_csrf=<%= csrfSecret %>"<% } %>>
            <%- include('../../partials/csrf', { csrfSecret }) %>
            <div class="card-header">
                <h3 class="card-header-title"><%- typeof title !== 'undefined' ? title : 'Firma' %></h3>
            </div>
            <div class="card-body">
                <div class="field">
                    <label class="field-label">Nazwa</label>
                    <input value="<%= form?.name %>" type="text" name="name" class="field-input" placeholder="Nazwa" />
                    <p class="field-help">Przynajmniej 3 znaki</p>
                    <% if(errors?.name) { %>
                        <div class="field-error"><%= errors.name.message %></div>
                    <% } %>
                </div>

                <div class="field">
                    <label class="field-label">Slug</label>
                    <input value="<%= form?.slug %>" type="text" name="slug" class="field-input" placeholder="Slug" />
                    <% if(errors?.slug) { %>
                        <div class="field-error"><%= errors.slug.message %></div>
                    <% } %>
                </div>

                <% if(showFile) { %>
                    <% if(form.image) { %>
                        <div class="flex items-center gap-3">
                            <img src="/img/uploads/<%= form.image %>" alt="" class="h-16 w-16 rounded-lg object-cover ring-1 ring-slate-200" />
                            <a href="/company/<%= form.slug %>/delete-img" class="btn-danger btn-sm">Usuń zdjęcie</a>
                        </div>
                    <% } %>
                    <div class="field">
                        <label class="field-label">Zdjęcie</label>
                        <input type="file" name="image" id="image" class="field-input" />
                    </div>
                <% } %>

                <div class="field">
                    <label class="field-label">Liczba pracowników</label>
                    <input value="<%= form?.employeesCount %>" type="number" name="employeesCount" class="field-input" />
                </div>
            </div>
            <div class="card-footer">
                <button class="btn-primary btn-block" type="submit">
                    <%- button %>
                </button>
            </div>
        </form>
    </div>
</div>
