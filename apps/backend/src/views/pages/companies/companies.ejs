<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="heading-page">Lista firm</h1>
        <div class="flex flex-wrap gap-2">
            <% if(user) { %>
                <a class="btn-primary" href="/<%= language ;%>/admin/company/add">+ Dodaj nową firmę</a>
            <% } %>
            <a class="btn-secondary" href="/csv">Pobierz listę firm</a>
        </div>
    </div>

    <form action="" class="flex flex-col gap-6 lg:flex-row lg:items-start">
        <div class="w-full shrink-0 lg:w-64">
            <div class="card p-5">
                <%- include('./partials/search') %>
                <%- include('./partials/filters') %>
            </div>
        </div>

        <div class="min-w-0 flex-1">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
                <% companies.forEach(company => { %>
                    <div class="card flex flex-col overflow-hidden">
                        <% if(company.image) { %>
                            <div class="h-44 w-full overflow-hidden bg-slate-800">
                                <img
                                        src="/img/uploads/<%- company.image %>"
                                        alt="<%= company.name %>" class="h-full w-full object-cover" />
                            </div>
                        <% } %>
                        <div class="flex flex-1 flex-col gap-2 p-5">
                            <h2 class="heading-section"><%= company.name %></h2>
                            <p class="text-sm text-slate-400">Liczba pracowników: <%= company.employeesCount %></p>
                            <p class="text-sm text-slate-500">Kontakt: <%= company.user?.email %></p>
                            <p class="text-sm text-slate-500">CEO: <%= company.user?.fullName %></p>
                        </div>
                        <div class="flex flex-col gap-2 p-5 pt-0">
                            <a class="btn-secondary btn-block" href="/company/<%= company.slug %>">Podgląd</a>
                            <% if(user && (company.user && company.user.id === user.id)) { %>
                                <a class="btn-secondary btn-block" href="/<%= language ;%>/admin/company/<%= company.slug %>/edit">Edytuj</a>
                                <a class="btn-danger btn-block"
                                   href="/<%= language ;%>/admin/company/<%= company.slug %>/delete"
                                   onclick="return confirm('Czy jesteś pewien?')">Usuń</a>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="mt-6">
                <%- include('./partials/pagination') %>
            </div>
        </div>
    </form>
</div>
