{
  "extends": "@repo/config-typescript/express.json",
  "compilerOptions": {
    "baseUrl": "./",
    "types": ["bun-types", "vitest/globals"],
    "outDir": "dist",
    "paths": {
      "@mongo/*": ["./src/db/mongo/*"],
      "@sql/*": ["./src/db/sql/*"],
      "@customTypes/*": ["./src/types/*"],
      "@interface/*": ["./src/interfaces/*"],
      "@services/*": ["./src/services/*"],
      "@static/*": ["./src/static/*"],
      "@utility/*": ["./src/utility/*"],
      "@config": ["./src/config.ts"]
    }
  },
  "include": ["./src/**/*.ts", "./test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
