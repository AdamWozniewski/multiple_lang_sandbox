{
  "name": "backend",
  "version": "1.0.0",
  "author": "adamw",
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@apollo/server-plugin-landing-page-graphql-playground": "^4.0.1",
    "@sentry/bun": "^10.8.0",
    "@sentry/cli": "^2.39.1",
    "@sentry/node": "^8.45.0",
    "@sentry/profiling-node": "^10.15.0",
    "@tailwindcss/cli": "^4.1.12",
    "@types/ejs": "^3.1.5",
    "@types/mongoose-unique-validator": "^1.0.9",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.0.2",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.1.0",
    "ejs": "^3.1.10",
    "express": "^5.0.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.1",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.0.5",
    "helmet": "^8.0.0",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.7.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "mongoose-unique-validator": "^4.0.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^5.0.4",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.1.12",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@repo/config-typescript": "workspace:*",
    "@graphql-tools/schema": "^10.0.23",
    "@graphql-tools/utils": "^10.8.6",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/html-vite": "^9.1.3",
    "@types/body-parser": "^1.19.5",
    "@types/bun": "^1.2.21",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/express-session": "^1.18.1",
    "@types/i18next": "^13.0.0",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/qrcode": "^1.5.5",
    "chromatic": "^13.1.4",
    "mongodb-memory-server": "^10.1.3",
    "start-server-and-test": "^2.0.8",
    "storybook": "^9.1.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.6"
  },
  "description": "backend - nodeJS",
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "ISC",
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "biome format --write",
      "biome check --fix --unsafe"
    ]
  },
  "private": true,
  "scripts": {
    "dev:server": "dotenv -e ../../.env -- bun --hot src/index.ts",
    "dev:css": "bunx tailwindcss -i public/css/main.css -o public/main.css --watch",
    "build": "bun run build:tsc && bun run build:css",
    "build:tsc": "dotenv -e ../../.env -- bun build src/index.ts --target bun --format esm --sourcemap --outdir dist",
    "build:css": "bunx @tailwindcss/cli -i public/css/main.css -o public/main.css -m",
    "start:prod": "NODE_ENV=production bun dist/index.js",
    "biome:lint": "biome lint .",
    "biome:format": "biome format . --write",
    "biome:check": "biome check .",
    "biome:check:fix": "biome check . --fix",
    "biome:check:fix:unsafe": "biome check . --fix --unsafe",
    "test:unit": "vitest",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org b2b-hs --project node-express ./dist && sentry-cli sourcemaps upload --org b2b-hs --project node-express ./dist",
    "storybook": "bunx storybook dev -p 6006",
    "build-storybook": "bunx storybook build",
    "chromatic": "dotenv -e .env -- npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN"
  },
  "type": "module"
}
