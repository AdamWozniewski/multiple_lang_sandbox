{
  "name": "multiple_lang_sandbox",
  "version": "1.0.0",
  "description": "multiple tech sandbox",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.0",
  "engines": {
    "bun": ">=1.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "aspire": "aspire run",
    "aspire:build": "tsc -p tsconfig.apphost.json",
    "aspire:watch": "tsc --watch -p tsconfig.apphost.json",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "biome:lint": "biome lint .",
    "biome:format": "biome format . --write",
    "biome:check": "biome check .",
    "biome:check:fix": "biome check . --fix",
    "biome:check:fix:unsafe": "biome check . --fix --unsafe",
    "test:e2e": "bunx playwright test --config playwright.config.ts",
    "allure:generate": "bunx allure generate allure-results --clean -o allure-report",
    "allure:open": "bunx allure open allure-report",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamWozniewski/multiple_lang_sandbox.git"
  },
  "author": "adamw",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AdamWozniewski/multiple_lang_sandbox/issues"
  },
  "homepage": "https://github.com/AdamWozniewski/multiple_lang_sandbox#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@eslint/js": "^9.39.5",
    "@microsoft/aspire-cli": "13.5.3",
    "@playwright/test": "^1.63.0",
    "@repo/config-biome": "*",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.1",
    "autoprefixer": "^10.6.1",
    "cssnano": "^7.1.9",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "less": "^4.9.1",
    "lint-staged": "^17.5.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.2.0",
    "sass": "^1.104.1",
    "sharp": "^0.34.5",
    "storybook": "^9.1.20",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@vitest/coverage-istanbul": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "i18next": "^26.4.2",
    "sanitize-filename": "^1.6.4",
    "vscode-jsonrpc": "^8.2.1"
  },
  "trustedDependencies": [
    "@microsoft/aspire-cli"
  ]
}
